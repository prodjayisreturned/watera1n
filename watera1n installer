#!/bin/bash

echo ""
echo "==============================="
echo "   Waterra1n macOS Installer"
echo "==============================="
echo ""

# === CONFIG ===
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_DIR="$SCRIPT_DIR/Waterra1n"
GIT_URL="__GITHUB_URL_HERE__"   # You will paste your GitHub URL here

# === Clone or update repo ===
if [ -d "$INSTALL_DIR/.git" ]; then
    echo "✔ Updating existing Waterra1n folder..."
    cd "$INSTALL_DIR"
    git pull --quiet
else
    echo "✔ Cloning Waterra1n repo..."
    git clone "$GIT_URL" "$INSTALL_DIR"
fi

# === Check assets ===
ASSETS_DIR="$INSTALL_DIR/assets"
SPLASH="$ASSETS_DIR/waterra1n_splash.png"
ICON="$ASSETS_DIR/waterra1n_icon.png"

echo ""

if [ -f "$SPLASH" ]; then
    echo "✔ Splash found"
else
    echo "✘ Splash missing"
fi

if [ -f "$ICON" ]; then
    echo "✔ Icon found"
else
    echo "✘ Icon missing"
fi

echo ""
echo "✔ Installation complete"
echo "Location: $INSTALL_DIR"
echo ""
